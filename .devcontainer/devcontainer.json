{
  "name": "GAS DevContainer",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "npm install && npm install -g @google/clasp",
  "forwardPorts": [],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=${localWorkspaceFolder}/../idoo-merkado,target=/workspace/vendor/idoo-merkado,type=bind,consistency=cached"
  ],
  "customizations":
  {
      "vscode":
      {
        "extensions": [
            "tomhoh.vscode-gas-fakes"
        ]
    }
  }
}